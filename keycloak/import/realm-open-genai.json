{
  "realm": "open-genai",
  "enabled": true,
  "displayName": "Open GENAI",
  "loginTheme": "keycloak",
  "sslRequired": "none",
  "registrationAllowed": false,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 43200,
  "groups": [
    {
      "name": "SystemAdminGroup"
    },
    {
      "name": "TeamAdminGroup"
    },
    {
      "name": "UserGroup"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "firstName": "者",
      "lastName": "管理",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "groups": [
        "/SystemAdminGroup"
      ]
    },
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "email": "user@example.com",
      "firstName": "ユーザー",
      "lastName": "一般",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "groups": [
        "/UserGroup"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "http://localhost/api/auth/saml/metadata",
      "name": "Open GENAI SP",
      "description": "Open GENAI backend (SAML Service Provider)",
      "protocol": "saml",
      "enabled": true,
      "fullScopeAllowed": true,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost/api/auth/saml/acs",
        "http://localhost/*"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml.force.post.binding": "true",
        "saml_name_id_format": "email",
        "saml_assertion_consumer_url_post": "http://localhost/api/auth/saml/acs",
        "saml_single_logout_service_url_redirect": "http://localhost/api/auth/saml/sls",
        "saml_signature_algorithm": "RSA_SHA256"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "friendly.name": "email"
          }
        },
        {
          "name": "name",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "attribute.name": "name",
            "attribute.nameformat": "Basic",
            "friendly.name": "name"
          }
        },
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "groups",
            "attribute.nameformat": "Basic",
            "friendly.name": "groups",
            "single": "true",
            "full.path": "false"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false, \"required\": {\"roles\": [\"user\"]}}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
