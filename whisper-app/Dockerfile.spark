# DGX Spark (aarch64 / GB10)。手元の CUDA 12.8 cuDNN イメージを使い、
# PyPI に無い aarch64+CUDA の CTranslate2 は Spark 向けバイナリをリンクする。
# cuBLAS 13 はホストの CUDA 13 ライブラリを実行時マウントする（compose 側）。
#
# 既定の Dockerfile は CPU 向け python:3.12-slim。このファイルは
# docker-compose.spark.yml からのみ参照する。
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    HF_HOME=/cache \
    CTRANSLATE2_ROOT=/opt/ctranslate2 \
    LD_LIBRARY_PATH=/opt/ctranslate2/lib:/opt/cuda13/lib:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

ARG CT2_BIN_URL=https://github.com/assix/ctranslate2-aarch64-cuda13-binaries/releases/download/v4.6.0-cuda13-aarch64/ctranslate2-dgxspark-aarch64-cuda13.tar.gz

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        python3-venv \
        build-essential \
        git \
        curl \
        ca-certificates \
        libgomp1 \
        libopenblas0 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL -o /tmp/ct2.tar.gz "${CT2_BIN_URL}" \
    && tar -xzf /tmp/ct2.tar.gz -C /opt \
    && rm /tmp/ct2.tar.gz \
    && echo /opt/ctranslate2/lib > /etc/ld.so.conf.d/ctranslate2.conf \
    && ldconfig

COPY requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --default-timeout=600 --retries 20 numpy \
    && python3 -m pip install --default-timeout=600 --retries 20 -r requirements.txt

# PyPI aarch64 の ctranslate2 は CPU 専用。C++ 本体は上で入れた CUDA 版に差し替える。
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip uninstall -y ctranslate2 \
    && git clone --depth 1 --branch v4.6.0 https://github.com/OpenNMT/CTranslate2.git /tmp/CTranslate2 \
    && python3 -m pip install -r /tmp/CTranslate2/python/install_requirements.txt \
    && CTRANSLATE2_ROOT=/opt/ctranslate2 python3 -m pip install /tmp/CTranslate2/python \
    && rm -rf /tmp/CTranslate2

COPY app ./app

EXPOSE 8002

CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8002"]
