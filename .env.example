# Open GENAI: docker compose 用の設定（コピーして .env として使用）

# --- リバースプロキシ（ローカル/検証: HTTP のみ）---
# ブラウザからのアクセス URL（末尾スラッシュ無し）。PROXY_HTTP_PORT と合わせること。
PUBLIC_URL=http://localhost
# proxy がホストに公開する HTTP ポート（80 が使用中なら 8080 等に変更）
PROXY_HTTP_PORT=80

# ホストで Ollama を動かす場合（推奨, macOS は Metal GPU が使えて高速）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Ollama もコンテナで動かす場合（docker compose --profile ollama up）は以下に変更
# OLLAMA_BASE_URL=http://ollama:11434

# --- 日程調整（オプション: profiles: ["chosei"]）---
# COMPOSE_PROFILES=chosei
# CHOSEI_PUBLIC_ENDPOINT=http://localhost:8010
# CHOSEI_PUBLIC_PORT=8010
# CHOSEI_RETENTION_DAYS=90
# CHOSEI_MODEL=qwen2.5:7b
# 詳細は docs/chosei.md

# --- 日程調整（オプション: profiles: ["chosei"]）---
# docker compose --profile chosei up -d
# または: COMPOSE_PROFILES=chosei
# CHOSEI_APP_URL=http://chosei-app:8010/invoke
# 外部ゲスト向け公開 URL（開発時は chosei-app のホスト公開ポート）
# CHOSEI_PUBLIC_ENDPOINT=http://localhost:8010
# CHOSEI_PUBLIC_PORT=8010
# CHOSEI_RETENTION_DAYS=90

# --- 書類読取とチェック（オプション: profiles: ["doccheck"]）---
# COMPOSE_PROFILES=doccheck
# DOCCHECK_APP_URL=http://doccheck-app:8011/invoke
# DOCCHECK_PUBLIC_ENDPOINT=http://localhost:8011
# DOCCHECK_PUBLIC_PORT=8011
# DOCCHECK_OCR_ENGINE=hybrid
# DOCCHECK_VISION_MODEL=gemma3:27b
# DOCCHECK_PADDLE_MIN_CONF=0.50
# AMD64 本番で本家 PaddleOCR を使う例:
# DOCCHECK_INSTALL_PADDLEOCR=1
# DOCCHECK_OCR_ENGINE=paddleocr
# DOCCHECK_ASSIGNEES=3
# DOCCHECK_SINGLE_ASSIGNEES=1
# DOCCHECK_OCR_NORMALIZE=1
# DOCCHECK_OCR_TARGET_DPI=300
# DOCCHECK_OCR_LONG_EDGE=3508
# 詳細は docs/doccheck.md

# --- フォーム（オプション: profiles: ["patchform"]）---
# COMPOSE_PROFILES=patchform
# PATCHFORM_APP_URL=http://patchform-app:8012/invoke
# PATCHFORM_PUBLIC_ENDPOINT=http://localhost:8012
# PATCHFORM_PUBLIC_PORT=8012
# PATCHFORM_RETENTION_DAYS=365
# PATCHFORM_MODEL=qwen2.5:7b
# PATCHFORM_VISION_MODEL=gemma3:12b
# PATCHFORM_GBIZ_TOKEN=
# PATCHFORM_SEED=1
# 職員通知メール（未設定なら送らない。手続きに宛先を書いたときだけ）
# PATCHFORM_SMTP_HOST=
# PATCHFORM_SMTP_PORT=587
# PATCHFORM_SMTP_USER=
# PATCHFORM_SMTP_PASSWORD=
# PATCHFORM_SMTP_STARTTLS=1
# PATCHFORM_SMTP_SSL=0
# PATCHFORM_SMTP_FROM=
# PATCHFORM_STAFF_BASE_URL=${PUBLIC_URL}
# 庁内バッチ向け（未設定なら使えない。読み取りだけ。ゲスト API では使わない）
# PATCHFORM_SERVICE_KEY=
# 通知メールの検証用テキスト出力。開発 compose の既定は /data/mail
# PATCHFORM_MAIL_DUMP_DIR=/data/mail
# 手続き MCP（同一ホスト Dify 向け。無認証。LGWAN-ASP 転送対象に載せない）
# PROCEDURE_MCP_PORT=8013
# PROCEDURE_MCP_BIND=127.0.0.1
# 詳細は docs/patchform.md / docs/procedure-mcp.md

# --- 情報化企画書ナビ（オプション: profiles: ["procuretech"]）---
# docker compose --profile procuretech up -d
# または: COMPOSE_PROFILES=procuretech
# PROCURETECH_APP_URL=http://procuretech-navigator-app:8014/invoke
# PROCURETECH_PORT=8014
# PROCURETECH_MODEL=qwen2.5:7b
# PROCURETECH_RETENTION_DAYS=30
# PROCURETECH_MAX_UPLOAD_BYTES=10485760
# 更新版 xlsx を SeaweedFS(S3) 経由の署名付き URL で配信する（要 S3_* 設定。既定は直接DL）
# PROCURETECH_DOWNLOAD_VIA_S3=true
# 詳細は docs/procuretech.md

# --- 情報化企画書エディタ（オプション: profiles: ["procuretech-editor"]）---
# docker compose --profile procuretech-editor up -d
# または: COMPOSE_PROFILES=procuretech-editor
# PROCURETECH_EDITOR_APP_URL=http://procuretech-editor-app:8015/invoke
# PROCURETECH_EDITOR_PORT=8015
# EDITOR_MAX_UPLOAD_BYTES=20971520
# ファイル本体は S3 互換ストレージ（SeaweedFS）に保存します（backend と同じ S3_* を共有）。
# EDITOR_S3_PREFIX=procuretech-editor
# 外部「文書生成」API（Excel→章別 Markdown。未設定なら「Excel から生成」は無効表示）。
# 生成ロジック（テンプレート＋LLM/Dify）は非公開の別サービスに閉じ込め、URL で差し替え可能。
# 結果は zip で受け取るため Nextcloud 非依存。
# EDITOR_GENERATE_URL=https://generate.example.local
# EDITOR_GENERATE_API_KEY=change-me
# EDITOR_GENERATE_TIMEOUT=180
# EDITOR_GENERATE_DOC_TYPE=specification
# 素の文書（テーマ無し）の Word 合成先。テーマ固有の生成 API に依存させないための汎用サービス。
# 既定は procuretech-generate-app（procuretech-editor プロファイルで同時起動）。
# EDITOR_COMPOSE_URL=http://procuretech-generate-app:8016
# EDITOR_COMPOSE_API_KEY=change-me
# テーマ定義(JSON)。テーマ（例: 調達仕様書）ごとに、必要なヒアリングシート（入力 Excel）と
# 呼び出す生成 API（api_url）・doc_type を管理者が紐づける。1 行の JSON 文字列で設定する。
# 未設定なら EDITOR_GENERATE_URL を使う単一テーマ（調達仕様書 / systemplan + global）が既定。
# EDITOR_GENERATE_THEMES=[{"id":"procurement_spec","label":"調達仕様書","doc_type":"specification","api_url":"http://procuretech-spec-app:8016","inputs":[{"key":"systemplan","label":"情報化企画書（systemplan.xlsx）","marker":"systemplan","accept":".xlsx","template":true},{"key":"global","label":"全般的事項（global.xlsx）","marker":"global","accept":".xlsx","template":true}]}]
# 実「調達仕様書」生成・合成サービス（Dify）を使う場合（profile: procuretech-spec）:
#   docker compose -f docker-compose.yml -f docker-compose.procuretech-spec.yml \
#     --profile procuretech-editor --profile procuretech-spec up -d
#   EDITOR_GENERATE_URL=http://procuretech-spec-app:8016
# Dify アプリキーはイメージに焼き込まず、procuretech-spec-app/dify_keys.json をマウント（既定）、
# もしくは PROCURETECH_DIFY_KEYS に JSON を設定して渡す:
# PROCURETECH_DIFY_KEYS={"background":"app-...","business":"app-...","actualsystem":"app-...","purpose":"app-...","functional_requirements":"app-...","worklet":"app-...","schedule":"app-..."}
# PROCURETECH_SPEC_PORT=8017
#
# 汎用サービス procuretech-generate-app は procuretech-editor プロファイルで同時起動する。
# これ単体を生成 API として使う場合（LLM/Dify 不要。同梱ヒアリングシートで生成〜合成〜様式DL）:
#   docker compose --profile procuretech-editor up -d
#   EDITOR_GENERATE_URL=http://procuretech-generate-app:8016
#   さらに単一入力のサンプルテーマを使う場合は EDITOR_GENERATE_THEMES に次を設定:
#   EDITOR_GENERATE_THEMES=[{"id":"sample","label":"サンプル文書","doc_type":"sample","api_url":"http://procuretech-generate-app:8016","inputs":[{"key":"hearing","label":"ヒアリングシート（hearing-sample.xlsx）","marker":"hearing-sample","accept":".xlsx","template":true}],"sections":[{"key":"background","label":"背景"},{"key":"purpose","label":"目的"},{"key":"target","label":"対象業務"},{"key":"requirements","label":"主要要件"},{"key":"schedule","label":"想定スケジュール"}],"outputs":[{"id":"doc","name":"サンプル文書","kind":"markdown","sections":["background","purpose","target","requirements","schedule"]}]}]
# PROCURETECH_GENERATE_PORT=8016
# GENERATE_PROCESS_SECONDS=2
# 詳細は docs/procuretech-editor.md

# LLM は OpenAI 互換 API 経由で呼び出します。
# 未指定なら OLLAMA_BASE_URL + /v1 を使用します。
# vLLM / LM Studio / OpenAI 等に向ける場合のみ設定してください。
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama

# 複数の OpenAI 互換プロバイダを併用する場合は LLM_PROVIDERS(JSON) を設定。
# modelId ごとに base_url/キーを振り分ける（詳細は .env.prod.example 参照）。
# LLM_PROVIDERS=[{"name":"ollama","base_url":"http://host.docker.internal:11434/v1","models":["qwen2.5:7b"]}]

# 既定で利用するモデル（フロントでモデル未選択時に使用）
DEFAULT_MODEL=qwen2.5:7b

# チャットタイトルの生成方式。
#   heuristic（既定）: LLM を使わずユーザー発話から題名を作る（速い・拒否で壊れない）
#   llm            : LLM でタイトル生成し、拒否/空のときはユーザー発話にフォールバック
TITLE_MODE=heuristic

# --- RAG「AI アプリ」設定 ---
# 埋め込みモデル（ollama pull mxbai-embed-large で取得）
EMBED_MODEL=mxbai-embed-large
# RAG 回答生成に使うモデル
RAG_MODEL=gpt-oss:20b
# AI アプリ呼び出し用 API キー（ローカル任意値）
RAG_API_KEY=local-rag-key

# --- ナレッジ検索 MCP（Dify Agent 連携用） ---
# 【重要・セキュリティ】knowledge-mcp は無認証で、scope(teamId) を呼び出し側が
# 任意指定できる。到達できれば全チームのナレッジを読み出せる。
# 当面は同一サーバ上の Dify のみ想定。LGWAN-ASP 転送対象に載せないこと。
# ホスト公開ポート（Dify から host.docker.internal:<port>/mcp で利用）。
KNOWLEDGE_MCP_PORT=8002
# 公開バインドアドレス。既定は 127.0.0.1（同一ホストのみ）。
# 特定 Dify ホストのみ許すなら Docker ブリッジの gateway IP を指定。
KNOWLEDGE_MCP_BIND=127.0.0.1

# --- 内部サービス間署名（x-user-* 偽装対策）---
# backend と全 exApp で同一値。空にすると検証を無効化（開発時のみ）。本番は必ず十分長い乱数に。
INTERNAL_SIGNING_SECRET=dev-internal-secret-change-me

# --- 成果物取得(SSRF 対策) ---
# 許可ホスト（カンマ区切り, 例: files.dify.ai）。空だと内部/プライベート宛先のみ拒否。
ARTIFACT_FETCH_ALLOWED_HOSTS=
# サーバが取得する成果物の最大サイズ（バイト。既定50MB）
ARTIFACT_MAX_BYTES=52428800
# RAG の URL 取り込み許可ホスト（カンマ区切り, 空=内部宛先のみ拒否）。行政ドメイン等に限定推奨
URL_FETCH_ALLOWED_HOSTS=

# --- 監査ログ参照(Audit) AI アプリ（管理者限定）---
# backend からのプロキシ先（通常は変更不要）
AUDIT_APP_URL=http://audit-app:8005/invoke

# --- 文字起こし(Whisper) AI アプリ ---
WHISPER_MODEL=medium        # small / medium / large-v3
WHISPER_DEVICE=cpu          # cpu / cuda（NVIDIA GPU + Container Toolkit）
WHISPER_COMPUTE=int8        # GPU なら float16 推奨
# 別エンジンにする場合は WHISPER_APP_URL を差し替える（/invoke と /health があれば可）。

# --- 画像生成(Stable Diffusion) AI アプリ ---
# 画像生成バックエンド: a1111（既定・GPU 自前運用）| fastsd（CPU-only, FastSD CPU/LCM）
SD_BACKEND=a1111
# 接続先 URL。未設定なら a1111=:7860 / fastsd=:8000 が既定（明示すればそれを優先）。
# SD_API_URL=http://host.docker.internal:7860
# --- fastsd を使う場合（SD_BACKEND=fastsd）---
#   ホスト等で FastSD CPU を `python src/app.py --api`（既定 :8000）で起動しておく。
#   フロントの初期 step/cfg は 4/1 が目安（下の VITE_APP_IMAGE_DEFAULT_* を参照）。
# SD_API_URL=http://host.docker.internal:8000
# SD_FASTSD_USE_OPENVINO=false        # OpenVINO で高速化する場合 true
# SD_FASTSD_USE_LCM_LORA=false
# SD_FASTSD_USE_TINY_AUTO_ENCODER=false
# SD_FASTSD_USE_SAFETY_CHECKER=false
# SD_FASTSD_MODEL_ID=                 # 例: Lykon/dreamshaper-8（未指定は FastSD 既定）
# SD_FASTSD_OPENVINO_MODEL_ID=        # OpenVINO 用モデル ID
# 画面に出すサービス名称（ヘッダー・フッター・ブラウザタブ。静的ビルド時は web 再ビルド）
# ゲスト HTML（日程調整・書類チェック・フォーム）は APP_TITLE。未設定なら VITE_APP_TITLE。
# VITE_APP_TITLE=Open GENAI
# APP_TITLE=Open GENAI
# 画像生成の初期 step / cfg（Vite dev server 用。FastSD/LCM は 4/1 が目安）
# VITE_APP_IMAGE_DEFAULT_STEP=50
# VITE_APP_IMAGE_DEFAULT_CFG=7

# --- 成果物ファイル配信用オブジェクトストレージ（自前 S3 互換: SeaweedFS）---
# AI アプリ（Dify等）が生成したファイルを自前ストレージへ再ホストし署名付きURLで配信。
# dev 既定は同梱の SeaweedFS。接続先を変えれば MinIO 等にも差し替え可能。
S3_ENDPOINT_URL=http://seaweedfs:8333
# 署名付きURL生成に使う公開エンドポイント（dev はホストから見える localhost:8333）
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=open-genai
# 認証情報（seaweedfs/s3.config.json と一致させること。本番は必ず変更）
S3_ACCESS_KEY=opengenai
S3_SECRET_KEY=opengenai-secret
# 署名付きURLの有効期限（秒。既定24時間）
S3_PRESIGN_EXPIRY=86400
# 成果物ファイルの保持日数（超過分は日次で SeaweedFS と実行履歴から削除。0=無効）
S3_ARTIFACT_RETENTION_DAYS=30
# 成果物パージの実行間隔（秒。既定24時間）
S3_ARTIFACT_PURGE_INTERVAL=86400
# 成果物再ホスト時に取得を許可するホスト（カンマ区切り）。
# Dify が返すファイル URL のホスト名を列挙する（API の dify_base_url とは別になり得る）。
# 例:
#   クラウド: files.dify.ai,upload.dify.ai
#   ローカル Docker: host.docker.internal
#   セルフホスト: files.example.gov.jp や nginx 等、FILES_URL のホスト
# allowlist に載せたホストは private/loopback 解決も許可（リンクローカルは拒否）。
ARTIFACT_FETCH_ALLOWED_HOSTS=files.dify.ai,upload.dify.ai,host.docker.internal
# 成果物の配信方式:
#   open    = 署名付きURLを結果画面に直接リンク（直接DL可能な環境向け。dev既定）
#   carrier = URLを画面に出さず「リンクファイル(.txt/.html)」で持ち出させる（LGWAN等の閉域向け）
ARTIFACT_DELIVERY_MODE=open
# carrier 時のリンクファイル形式（txt / html / both）。both は UI からの指定で切替
ARTIFACT_CARRIER_FORMAT=txt

# --- Dify 連携 AI アプリ ---
# Dify(ワークフロー/チャットフロー)を「AI アプリ」として登録するための汎用プロキシ。
# アプリ登録時の endpoint に使う値（通常は変更不要）。
DIFY_APP_URL=http://dify-app:8004/invoke
# 既定の Dify 接続先(base_url, 末尾 /v1)。任意。
# 各 AI アプリの「設定(config)」で個別に指定する場合は空のままで構いません。
# 例: DIFY_BASE_URL=http://host.docker.internal/v1
# DIFY_BASE_URL=

# --- SAML 認証（backend = SAML SP / Keycloak = SAML IdP）---
# アプリ JWT 署名鍵（本番では十分長いランダム値に変更すること）
APP_JWT_SECRET=change-me-open-genai-secret
# Keycloak 管理者（proxy 経由 http://localhost/kc/ の admin console 用）
# ※ 利用者一括管理(usermgmt-app) はこの管理者資格情報で Keycloak Admin API を呼ぶ
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# usermgmt-app から見た Keycloak の内部URL（proxy 経由 /kc）
# KEYCLOAK_INTERNAL_URL=http://keycloak:8080/kc
KEYCLOAK_REALM=open-genai

# --- 監査ログ（利用状況/内容ログ・8-(1) 対応）---
# 監査ログ機能の有効化
AUDIT_ENABLED=true
# 監査ログ DB（チャット履歴とは独立、append-only）
AUDIT_DB_PATH=/data/audit.db
# 入出力の内容を保存するか（false の場合は文字数のみ記録）
AUDIT_STORE_CONTENT=true
# 内容保存の上限文字数
AUDIT_MAX_CONTENT_CHARS=8000
# 保持日数（最低 1095=3年。既定 1825=5年。3年未満を指定しても 1095 に切り上げ）
AUDIT_RETENTION_DAYS=1825

# --- チャット履歴のユーザー別分離（6-(8) 対応）---
# userId 列が無い既存チャットの移管先（メール/sub）。空なら移管せず不可視化。
# LEGACY_CHAT_OWNER=

# --- 個人情報検知（添付警告・ナレッジラベル）---
# 氏名 NER 用に GiNZA（spaCy）を backend / rag-app イメージへ入れる。0=入れない（既定）
# PII_INSTALL_NER=0
# 同期添付の NER 文字数上限 / ナレッジ非同期経路の上限
# PII_NER_MAX_CHARS=8000
# PII_KNOWLEDGE_NER_MAX_CHARS=200000
