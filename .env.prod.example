# Open GENAI 本番用の設定（コピーして .env.prod として使用）
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build
#
# 方針: ユーザ公開は proxy のみ。フロントの API 参照は相対 /api。

# === 必須: 公開URL（proxy 経由のベースURL。末尾スラッシュ無し）===
# 本番 TLS:  https://genai.example.lg.jp
# 閉域検証:  http://localhost  （docker-compose.verify.yml と併用）
PUBLIC_URL=https://genai.example.lg.jp
# EntityID だけ旧ホストのまま残す場合（ACS/SLS は PUBLIC_URL 側）
# SAML_SP_ENTITY_ID=https://old.example.lg.jp/api/auth/saml/metadata

# proxy がホストに公開するポート
# 本番 TLS: PROXY_HTTP_PORT=80, PROXY_HTTPS_PORT=443
# 閉域検証: PROXY_HTTP_PORT=80（80 使用中なら 8080 等。PUBLIC_URL も合わせる）
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# 待ち受け IP（未設定は 0.0.0.0）。NIC に複数アドレスがあるときだけ指定。
# PROXY_BIND_IP=192.0.2.10

# 本番/検証(prod.yml)の web は静的ビルド（Dockerfile.prod + nginx）で配信するため、
# この VITE_ALLOWED_HOSTS は使用しません（Vite dev server 用。dev の docker-compose.yml のみ）。
# VITE_ALLOWED_HOSTS=genai.example.lg.jp

# 画面に出すサービス名称（ヘッダー・フッター・ブラウザタブ）
# 静的ビルドの build.args に渡すため、変更時は web の再ビルドが必要。
VITE_APP_TITLE=Open GENAI

# ナビ配置: header（上部リンク）| sidebar（左メニュー: おすすめ / ピン留め / 全AIアプリ）
# 静的ビルドの build.args に渡すため、変更時は web の再ビルドが必要。
VITE_APP_NAV_LAYOUT=header
# 画像生成の初期 step / cfg（静的ビルドに埋め込み。変更時は web 再ビルド）。
# 既定は 50 / 7（標準 SD/SDXL 向け）。SD_BACKEND=fastsd（CPU-only, LCM）では 4 / 1 が目安。
VITE_APP_IMAGE_DEFAULT_STEP=50
VITE_APP_IMAGE_DEFAULT_CFG=7
# 画面のモデル一覧（JSON 配列）。compose の YAML が配列と誤認しないよう単引用符で囲む。
# 変更時は web の再ビルドが必要。
# VITE_APP_MODEL_IDS='["gpt-4.1","claude-sonnet-4-6"]'

# === 認証・鍵（本番では必ず変更。未変更のままだと backend 起動時に警告が出ます）===
# 生成例: openssl rand -hex 32
APP_JWT_SECRET=please-change-to-a-long-random-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=please-change-me
# backend↔exApp 間の署名鍵（x-user-* 偽装対策）。必須・十分長い乱数（例: openssl rand -hex 32）
INTERNAL_SIGNING_SECRET=please-change-to-a-long-random-secret

# 運用者ホスト専用の ID/PW ログイン（Keycloak と別経路）。
# Host が一致し、かつ OPERATOR_USERS が空でないときだけ /auth/login がフォームになる。
# パスワードは bcrypt ハッシュ。生成例:
#   python3 -c "import bcrypt,getpass; p=getpass.getpass(); print(bcrypt.hashpw(p.encode(), bcrypt.gensalt()).decode())"
# OPERATOR_LOGIN_HOSTS=ops.example.lg.jp
# OPERATOR_USERS='[{"email":"ops@example.jp","name":"運用者","password_hash":"$2b$12$...","groups":["SystemAdminGroup"]}]'
# 添付 /files URL の HMAC 鍵（未設定時は APP_JWT_SECRET を流用）
# FILES_URL_SECRET=
# Keycloak 本番DB（既定 dev-file=組込H2 は非推奨。実運用は postgres 等を強く推奨）
# KC_DB=postgres  # 併せて KC_DB_URL / KC_DB_USERNAME / KC_DB_PASSWORD を設定
KC_DB=dev-file
# Keycloak 管理コンソール (/kc/admin) は nginx 既定で全拒否。
# 管理網から許可する場合は proxy/kc-admin-allow.conf に allow CIDR を追記する。

# === LLM 接続（OpenAI 互換）===
OLLAMA_BASE_URL=http://host.docker.internal:11434
# --- 単一プロバイダ（後方互換）---
# OPENAI_BASE_URL / OPENAI_API_KEY を指定すると、その 1 系統だけを使う。
# OPENAI_BASE_URL=
# OPENAI_API_KEY=ollama
DEFAULT_MODEL=qwen2.5:7b

# チャットタイトルの生成方式。
#   heuristic（既定）: LLM を使わずユーザー発話から題名を作る（速い・拒否で壊れない）
#   llm            : LLM でタイトル生成し、拒否/空のときはユーザー発話にフォールバック
TITLE_MODE=heuristic

# --- 複数プロバイダ併用（任意）---
# LLM_PROVIDERS を設定すると modelId ごとに base_url/キーを振り分ける。
# api_key は api_key_env で環境変数名を参照（秘密は各 *_API_KEY に入れる）。
# Azure OpenAI は auth_header/api-version が異なるため auth_header と query を指定する。
# 例（1 行で設定すること）:
# LLM_PROVIDERS=[
#   {"name":"sakura","base_url":"https://api.ai.sakura.ad.jp/v1","api_key_env":"SAKURA_API_KEY","models":["gpt-oss-120b","preview/gemma-4-31B-it"]},
#   {"name":"ollama","base_url":"http://host.docker.internal:11434/v1","models":["qwen2.5:7b","gemma3:27b"]},
#   {"name":"openai","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_PROVIDER_API_KEY","models":["gpt-4.1"]},
#   {"name":"anthropic","base_url":"https://api.anthropic.com/v1","api_key_env":"ANTHROPIC_API_KEY","models":["claude-sonnet-4-6"],"extra_body":{"max_tokens":8192}},
#   {"name":"gemini","base_url":"https://generativelanguage.googleapis.com/v1beta/openai","api_key_env":"GEMINI_API_KEY","models":["gemini-3.6-flash"]},
#   {"name":"azure","base_url":"https://<resource>.openai.azure.com/openai/deployments/<deployment>","api_key_env":"AZURE_OPENAI_API_KEY","auth_header":"api-key","auth_prefix":"","query":{"api-version":"2024-10-21"},"models":["<deployment>"]}
# ]
LLM_PROVIDERS=
SAKURA_API_KEY=
OPENAI_PROVIDER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=

# === RAG / 監査 / 各 AI アプリ ===
# --- 埋め込みモデル（任意の OpenAI 互換サーバに差し替え可能）---
# 既定は Ollama 上の mxbai-embed-large（1024 次元）。EMBED_BASE_URL 未設定なら
# OPENAI_BASE_URL / OPENAI_API_KEY を使う（従来挙動）。
# ※ モデルを変えると次元が変わる。Qdrant コレクションは次元固定のため、モデル変更時は
#    QDRANT_COLLECTION を別名にし、全件を再インデックスすること（既存と混在不可）。
EMBED_MODEL=mxbai-embed-large
EMBED_DIM=1024
# QDRANT_COLLECTION=open_genai_rag
# 埋め込みだけ別エンドポイントへ分離する場合に設定（embed サイドカー / 外部の埋め込みAPI）。
# EMBED_BASE_URL=
# EMBED_API_KEY=
# 検索クエリ/文書の prefix はモデル依存。既定は mxbai 互換（クエリのみ英語 prefix・文書なし）。
# EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
# EMBED_DOC_PREFIX=
#
# --- 例: ローカル日本語埋め込み ruri-v3-310m を embed サイドカーで使う場合 ---
#   下記を有効化し、`docker compose --profile embed ...`（または COMPOSE_PROFILES=embed）で起動する。
# COMPOSE_PROFILES=embed
#
# --- 日程調整（オプション: profiles: ["chosei"]）---
#   外部ゲスト用 URL を別ホストで公開する（/public のみ。proxy/chosei.public.conf.example 参照）。
#   embed と併用する場合は COMPOSE_PROFILES=embed,chosei
# COMPOSE_PROFILES=chosei
# CHOSEI_PUBLIC_ENDPOINT=https://chosei.example.lg.jp
# CHOSEI_RETENTION_DAYS=90
# CHOSEI_MODEL=qwen2.5:7b
# 詳細は docs/chosei.md
#
# --- 書類読取とチェック（オプション: profiles: ["doccheck"]）---
#   外部ゲスト用 URL を別ホストで公開する（/public のみ。proxy/doccheck.public.conf.example 参照）。
# COMPOSE_PROFILES=doccheck
# DOCCHECK_PUBLIC_ENDPOINT=https://doccheck.example.lg.jp
# DOCCHECK_INSTALL_PADDLEOCR=1
# DOCCHECK_OCR_ENGINE=paddleocr
# DOCCHECK_VISION_MODEL=gemma3:27b
# DOCCHECK_PADDLE_MIN_CONF=0.50
# DOCCHECK_ASSIGNEES=3
# DOCCHECK_SINGLE_ASSIGNEES=1
# DOCCHECK_OCR_NORMALIZE=1
# 詳細は docs/doccheck.md
#
# --- フォーム（オプション: profiles: ["patchform"]）---
#   外部ゲスト用 URL を別ホストで公開する（/public のみ。proxy/patchform.public.conf.example 参照）。
# COMPOSE_PROFILES=patchform
# PATCHFORM_PUBLIC_ENDPOINT=https://form.example.lg.jp
# PATCHFORM_RETENTION_DAYS=365
# PATCHFORM_MODEL=qwen2.5:7b
# PATCHFORM_VISION_MODEL=gemma3:12b
# PATCHFORM_GBIZ_TOKEN=
# PATCHFORM_SEED=0
# 職員通知メール（庁内 SMTP。未設定なら送らない）
# PATCHFORM_SMTP_HOST=smtp.example.lg.jp
# PATCHFORM_SMTP_PORT=587
# PATCHFORM_SMTP_USER=
# PATCHFORM_SMTP_PASSWORD=
# PATCHFORM_SMTP_STARTTLS=1
# PATCHFORM_SMTP_SSL=0
# PATCHFORM_SMTP_FROM=noreply@example.lg.jp
# PATCHFORM_STAFF_BASE_URL=https://genai.example.lg.jp
# 庁内バッチ向け（未設定なら使えない。読み取りだけ）
# PATCHFORM_SERVICE_KEY=
# 通知メールの検証用テキスト出力（本番は空のまま）
# PATCHFORM_MAIL_DUMP_DIR=
# 手続き MCP（同一サーバ Dify 向け。LGWAN-ASP 転送対象に載せない）
# PROCEDURE_MCP_PORT=8104
# PROCEDURE_MCP_BIND=127.0.0.1
# 詳細は docs/patchform.md / docs/procedure-mcp.md
# EMBED_BASE_URL=http://embed:80/v1
# EMBED_API_KEY=-
# EMBED_MODEL=cl-nagoya/ruri-v3-310m
# EMBED_DIM=768
# QDRANT_COLLECTION=open_genai_rag_ruri_v3_310m
# EMBED_QUERY_PREFIX=検索クエリ: 
# EMBED_DOC_PREFIX=検索文書: 
#
RAG_MODEL=gpt-oss:20b
RAG_API_KEY=change-me-local-rag-key
# 起動時のサンプル自動投入。本番でサンプル不要なら false。
RAG_SEED_SAMPLES=false
# ナレッジ MCP（同一サーバ Dify 向け。LGWAN-ASP 転送対象に載せない）
# KNOWLEDGE_MCP_PORT=8103
# KNOWLEDGE_MCP_BIND=127.0.0.1
AUDIT_ENABLED=true
AUDIT_STORE_CONTENT=true
AUDIT_MAX_CONTENT_CHARS=8000
AUDIT_RETENTION_DAYS=1825
# LEGACY_CHAT_OWNER=

# --- 個人情報検知（添付警告・ナレッジラベル）---
# 氏名・住所 NER に GiNZA（spaCy）を使う場合は 1 にして backend / rag-app を再ビルド。
# 未設定(=0)でも電話・マイナンバー・住所パターンは動作する。詳細は README「入力制限と個人情報検知」。
# PII_INSTALL_NER=1
# PII_NER_MAX_CHARS=8000
# PII_KNOWLEDGE_NER_MAX_CHARS=200000

# --- 文字起こし / 画像生成 ---
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
# 画像生成バックエンド: a1111（既定・GPU 自前運用）| fastsd（CPU-only, FastSD CPU/LCM）
SD_BACKEND=a1111
# 接続先 URL。未設定なら a1111=:7860 / fastsd=:8000 が既定（明示すればそれを優先）。
SD_API_URL=http://host.docker.internal:7860
# --- fastsd を使う場合（SD_BACKEND=fastsd。CPU-only 本番など）---
#   FastSD CPU を外部で `python src/app.py --api`（既定 :8000）として起動しておく。
#   併せて web を VITE_APP_IMAGE_DEFAULT_STEP=4 / _CFG=1 で再ビルドすると UX が揃う。
# SD_API_URL=http://host.docker.internal:8000
# SD_FASTSD_USE_OPENVINO=false
# SD_FASTSD_USE_LCM_LORA=false
# SD_FASTSD_USE_TINY_AUTO_ENCODER=false
# SD_FASTSD_USE_SAFETY_CHECKER=false
# SD_FASTSD_MODEL_ID=
# SD_FASTSD_OPENVINO_MODEL_ID=

# === 成果物ファイル配信（自前 S3 互換: SeaweedFS）===
S3_ENDPOINT_URL=http://seaweedfs:8333
# 必須: 利用者がインターネットから取得する公開URL（TLS 付きの配信ドメイン）
#   例: https://files.example.lg.jp
S3_PUBLIC_ENDPOINT=https://files.example.lg.jp
S3_BUCKET=open-genai
# seaweedfs/s3.config.json と一致させる（本番用に必ず変更）
S3_ACCESS_KEY=please-change-access-key
S3_SECRET_KEY=please-change-secret-key
# 署名付きURLの有効期限（秒）。データ持ち出しの遅延を見込み本番は長め(例:259200=72h)も検討
S3_PRESIGN_EXPIRY=86400
# 成果物の配信方式（LGWAN 等では carrier 推奨）:
#   open    = 署名付きURLを結果画面に直接リンク（LGWAN 端末では本体を取得できない）
#   carrier = URLを画面に出さず「リンクファイル(.txt/.html)」で持ち出させ、別端末で開く
ARTIFACT_DELIVERY_MODE=carrier
# carrier 時のリンクファイル形式（txt / html / both）。txt が最もフィルタを通りやすい
ARTIFACT_CARRIER_FORMAT=txt
# 成果物取得(SSRF 対策): 生成元の既知ホストのみ許可することを推奨（カンマ区切り）
#   例（クラウド）: ARTIFACT_FETCH_ALLOWED_HOSTS=files.dify.ai,upload.dify.ai
#   例（ローカル Docker）: 上記に ,host.docker.internal を追加
#   例（セルフホスト）: FILES_URL のホスト名を追加（allowlist ホストは private IP も可）
ARTIFACT_FETCH_ALLOWED_HOSTS=
ARTIFACT_MAX_BYTES=52428800
# RAG の URL 取り込み許可ホスト（カンマ区切り）。本市 HP 等の既知ドメインに限定を推奨
#   例: URL_FETCH_ALLOWED_HOSTS=www.city.example.lg.jp
URL_FETCH_ALLOWED_HOSTS=

# ============================================================================
# 閉域検証（HTTP のみ・自己署名証明書不要）
# ============================================================================
# PUBLIC_URL=http://localhost
# PROXY_HTTP_PORT=80
# VITE_ALLOWED_HOSTS=true
# S3_PUBLIC_ENDPOINT=http://localhost:8333  # または別途配信経路
# 起動:
#   docker compose -f docker-compose.prod.yml -f docker-compose.verify.yml \
#     --env-file .env.prod up --build
# アクセス: http://localhost/ （ポート変更時は PUBLIC_URL も合わせる）

# ============================================================================
# 併せて必要な「設定ファイル」側の変更（このファイルでは反映されない項目）
# ============================================================================
# 1) フロントの API 参照は docker-compose.prod.yml の build.args で VITE_APP_*=/api を
#    ビルド時に静的バンドルへ埋め込み済み（相対 /api）。変更時は web の再ビルドが必要。
#    ホストで genai-web を直接起動する場合のみ packages/web/.env に設定:
#      VITE_APP_API_ENDPOINT=/api
#      VITE_APP_TEAM_ACCESS_CONTROL_API_ENDPOINT=/api
#
# 2) Keycloak の SAML クライアント(SP)登録を公開URLに合わせる:
#    keycloak/import/realm-open-genai.json の以下を PUBLIC_URL に置換
#    （初回 import 前に編集、または admin コンソールで既存を更新）
#      clientId:                             {PUBLIC_URL}/api/auth/saml/metadata
#      redirectUris:                         {PUBLIC_URL}/api/auth/saml/acs, {PUBLIC_URL}/*
#      saml_assertion_consumer_url_post:     {PUBLIC_URL}/api/auth/saml/acs
#      saml_single_logout_service_url_redirect: {PUBLIC_URL}/api/auth/saml/sls
#
# 3) 本番 TLS 時のみ: 証明書を proxy/certs/{fullchain.pem,privkey.pem} に配置
