+/// A new file's name, before anyone has named it. Saving one asks for a name.
+pub(crate) fn is_initial_office_name(name: &str) -> bool {
+    let base = name.rsplit(['/', '\\']).next().unwrap_or(name).trim();
+    matches!(
+        base,
+        "document.docx"
+            | "workbook.xlsx"
+            | "presentation.pptx"
+            | "Book1.xlsx"
+            | "Document1.docx"
+            | "Presentation1.pptx"
+            | "文書 1.docx"
+            | "プレゼンテーション 1.pptx"
+    )
+}
+
+/// The name offered when a new file is saved: the first line of the document, or the initial name when there is none.
+pub(crate) fn suggested_name_from_lines<'a>(current: &str, lines: impl IntoIterator<Item = &'a str>) -> String {
+    match file_stem_from_content(lines) {
+        Some(stem) => save_as_file_name(current, &stem).unwrap_or_else(|| current.to_string()),
+        None => current.to_string(),
+    }
+}
+
+fn suggested_office_name(current: &str, presentation: &ibis_doc_model::Presentation) -> String {
+    let lines = office_content_lines(presentation);
+    suggested_name_from_lines(current, lines.iter().map(String::as_str))
+}
+
+fn office_content_lines(presentation: &ibis_doc_model::Presentation) -> Vec<String> {
+    let mut lines = Vec::new();
+    if let Some(flow) = &presentation.flow {
+        for block in &flow.body {
+            push_flow_block(&mut lines, block);
+        }
+        return lines;
+    }
+    for slide in &presentation.slides {
+        let before = lines.len();
+        for shape in &slide.shapes {
+            match &shape.kind {
+                ibis_doc_model::ShapeKind::TextBox(body) => push_text_body(&mut lines, body),
+                ibis_doc_model::ShapeKind::Auto(shape) => {
+                    if let Some(body) = &shape.text {
+                        push_text_body(&mut lines, body);
+                    }
+                }
+                ibis_doc_model::ShapeKind::Sheet(sheet) => {
+                    for cell in &sheet.cells {
+                        let text = cell.text.trim();
+                        if !text.is_empty() {
+                            lines.push(text.to_string());
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        if lines.len() > before {
+            break;
+        }
+    }
+    lines
+}
+
+fn push_text_body(lines: &mut Vec<String>, body: &ibis_doc_model::text::TextBody) {
+    for paragraph in &body.paragraphs {
+        let text = paragraph.text();
+        if !text.trim().is_empty() {
+            lines.push(text);
+        }
+    }
+}
+
+fn push_flow_block(lines: &mut Vec<String>, block: &ibis_doc_model::flow::Block) {
+    match block {
+        ibis_doc_model::flow::Block::Paragraph(paragraph) => {
+            let mut text = String::new();
+            for run in &paragraph.runs {
+                match &run.kind {
+                    ibis_doc_model::flow::FlowRunKind::Text(value)
+                    | ibis_doc_model::flow::FlowRunKind::FileName(value) => text.push_str(value),
+                    ibis_doc_model::flow::FlowRunKind::Field { shown, .. } => text.push_str(shown),
+                    ibis_doc_model::flow::FlowRunKind::Ruby { base, .. } => text.push_str(base),
+                    ibis_doc_model::flow::FlowRunKind::PageRef { shown, .. } => text.push_str(shown),
+                    _ => {}
+                }
+            }
+            if !text.trim().is_empty() {
+                lines.push(text);
+            }
+        }
+        ibis_doc_model::flow::Block::Table(table) => {
+            for row in &table.rows {
+                for cell in &row.cells {
+                    for block in &cell.blocks {
+                        push_flow_block(lines, block);
+                    }
+                }
+            }
+        }
+    }
+}
+
+pub(crate) fn file_stem_from_content<'a>(lines: impl IntoIterator<Item = &'a str>) -> Option<String> {
+    for line in lines {
+        let text = line.split_whitespace().collect::<Vec<_>>().join(" ");
+        if text.is_empty() || is_placeholder_text(&text) {
+            continue;
+        }
+        let stem = shorten_file_stem(&text);
+        if !stem.is_empty() {
+            return Some(stem);
+        }
+    }
+    None
+}
+
+fn is_placeholder_text(text: &str) -> bool {
+    text.starts_with("クリックして")
+        || text.starts_with("マスター タイトル")
+        || text.starts_with("マスター テキスト")
+        || text.to_lowercase().starts_with("click to add")
+        || matches!(text, "Sheet1" | "シート1" | "Slide 1" | "スライド 1")
+}
+
+fn shorten_file_stem(text: &str) -> String {
+    let cleaned: String = text
+        .chars()
+        .map(|c| if matches!(c, '/' | '\\' | ':' | '*' | '?' | '"' | '<' | '>' | '|') { ' ' } else { c })
+        .collect();
+    let cleaned = cleaned.split_whitespace().collect::<Vec<_>>().join(" ");
+    let limit = 40;
+    if cleaned.chars().count() <= limit {
+        return cleaned.trim_end_matches(['。', '、', ' ', '.', '，', '！', '？', '!', '?']).trim().to_string();
+    }
+    let head: String = cleaned.chars().take(limit).collect();
+    if let Some(index) = head.rfind(['。', '、', '！', '？', '!', '?', ' ', '　']) {
+        let cut = head[..index].trim().trim_end_matches(['。', '、', '！', '？', '!', '?']);
+        if cut.chars().count() >= 4 {
+            return cut.to_string();
+        }
+    }
+    head.trim().to_string()
+}
+
+/// The name 名前を付けて保存 keeps: the open file's extension stays, so a workbook is not handed out as a document.
+pub(crate) fn save_as_file_name(current: &str, entered: &str) -> Option<String> {
+    let ext = current.rsplit_once('.').map(|(_, ext)| ext).filter(|ext| !ext.is_empty()).unwrap_or("");
+    let cleaned = entered.trim().replace(['/', '\\'], "_");
+    if cleaned.is_empty() || cleaned.chars().any(|c| c.is_control()) {
+        return None;
+    }
+    let stem = match cleaned.rsplit_once('.') {
+        Some((stem, suffix)) if !stem.is_empty() && !ext.is_empty() && suffix.eq_ignore_ascii_case(ext) => stem,
+        Some((stem, suffix)) if !stem.is_empty() && is_known_office_extension(suffix) => stem,
+        _ => cleaned.as_str(),
+    };
+    let stem = stem.trim().trim_end_matches('.').trim();
+    if stem.is_empty() || stem.ends_with(' ') {
+        return None;
+    }
+    if ext.is_empty() {
+        return Some(stem.to_string());
+    }
+    Some(format!("{stem}.{ext}"))
+}
+
+fn is_known_office_extension(suffix: &str) -> bool {
+    matches!(
+        suffix.to_ascii_lowercase().as_str(),
+        "docx" | "xlsx" | "pptx" | "doc" | "xls" | "ppt" | "pdf" | "png" | "txt" | "md" | "html" | "odt" | "ods" | "odp"
+    )
+}
+
+#[cfg(target_arch = "wasm32")]
+fn prompt_save_as_name(current: &str) -> Option<String> {
+    let window = js_sys::global();
+    let prompt = js_sys::Reflect::get(&window, &JsValue::from_str("prompt")).ok()?;
+    let function = prompt.dyn_ref::<js_sys::Function>()?;
+    let message = crate::i18n::text("shell.rename-file.name");
+    let result = function.call2(&window, &JsValue::from_str(&message.to_string()), &JsValue::from_str(current)).ok()?;
+    if result.is_null() || result.is_undefined() {
+        return None;
+    }
+    save_as_file_name(current, &result.as_string()?)
+}
