+/// Open an editor on a file read with `ibis_pptx::open`, keeping the package
+/// saving writes from. The browser `run` uses this: `read` alone drops the
+/// package, and the download button then refuses the file as a new document.
+pub fn open_editor_keeping_source(
+    presentation: ibis_doc_model::Presentation,
+    name: SharedString,
+    source: std::sync::Arc<ibis_pptx::Source>,
+    cx: &mut App,
+) {
+    open_window_sized(1280., cx, move |editor, window, cx| {
+        editor.load(presentation, name, window, cx);
+        editor.set_loaded_source(source);
+    });
+}
