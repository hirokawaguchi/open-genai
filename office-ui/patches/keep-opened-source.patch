+    presentation: ibis_doc_model::Presentation,
+    name: SharedString,
+    source: std::sync::Arc<ibis_pptx::Source>,
+    cx: &mut App,
+) {
+    open_window_sized(1280., cx, move |editor, window, cx| {
+        editor.load(presentation, name, window, cx);
+        editor.set_loaded_source(source);
+    });
+}
