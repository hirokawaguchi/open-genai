# 書類読取とチェックの外部公開用 nginx 設定例（Open GENAI 本体とは別ホストで運用）
#
# 重要:
#   - /public のみを doccheck-app へ upstream すること
#   - Open GENAI の /api・Keycloak・庁内 UI をこのホストから到達可能にしないこと
#
# 起動例（doccheck-app が Docker ネットワーク上にある場合）:
#   upstream を open-genai-doccheck-app:8011 に向け、この conf を別プロキシで読む。
#
# DOCCHECK_PUBLIC_ENDPOINT にはこのプロキシの公開 URL（例: https://doccheck.example.lg.jp）を設定する。

upstream doccheck_app {
    server open-genai-doccheck-app:8011;
}

server {
    listen 443 ssl;
    server_name doccheck.example.lg.jp;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    # ゲスト UI・API のみ
    location /public/ {
        proxy_pass http://doccheck_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /public {
        return 302 /public/;
    }

    # それ以外は拒否（誤って内部 API を晒さない）
    location / {
        return 404;
    }
}
